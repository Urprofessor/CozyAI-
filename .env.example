# Copy to .env.local for local development.
# On Vercel: Project Settings → Environment Variables.

DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# Either these (direct Upstash):
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ...or these (Vercel Marketplace injects these automatically when you
# attach an Upstash Redis via Storage). The redis lib checks both prefixes.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# "Bring what your AI knows" email (Resend). Without a key the app only
# previews the email. RESEND_FROM defaults to the Resend test sender, which can
# only email the Resend account owner until a domain is verified.
RESEND_API_KEY=
RESEND_FROM=
