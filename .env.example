# Copy to .env.local for local development.
# On Vercel: Project Settings → Environment Variables.

DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# Either these (direct Upstash):
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ...or these (Vercel Marketplace injects these automatically when you
# attach an Upstash Redis via Storage). The redis lib checks both prefixes.
KV_REST_API_URL=
KV_REST_API_TOKEN=
